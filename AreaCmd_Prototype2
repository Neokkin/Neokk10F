local function RayBoxIntersection(rayOrigin, rayDirection, boxCFrame, boxSize)
    local localOrigin = boxCFrame:PointToObjectSpace(rayOrigin)
    local localDir = boxCFrame:VectorToObjectSpace(rayDirection)
    local halfSize = boxSize / 2
    local tMin, tMax = -math.huge, math.huge
    
    local axes = {
        {localOrigin.X, localDir.X, halfSize.X},
        {localOrigin.Y, localDir.Y, halfSize.Y},
        {localOrigin.Z, localDir.Z, halfSize.Z}
    }
    
    for _, axis in ipairs(axes) do
        local originVal, dirVal, extent = axis[1], axis[2], axis[3]
        if math.abs(dirVal) < 1e-6 then
            if math.abs(originVal) > extent then return nil end
        else
            local t1 = (-extent - originVal) / dirVal
            local t2 = (extent - originVal) / dirVal
            if t1 > t2 then t1, t2 = t2, t1 end
            if t1 > tMin then tMin = t1 end
            if t2 < tMax then tMax = t2 end
            if tMin > tMax then return nil end
        end
    end
    return tMax >= 0 and (tMin > 0 and tMin or tMax) or nil
end

local function ParseCondition(valStr, currentVal, maxVal)
    if not valStr or valStr == "" then return true end
    valStr = string.gsub(valStr, "%s+", "")
    local isPercent = string.find(valStr, "%%") ~= nil
    valStr = string.gsub(valStr, "%%", "")
    
    local op, numStr = "==", valStr
    if string.sub(valStr, 1, 2) == "<=" then op, numStr = "<=", string.sub(valStr, 3)
    elseif string.sub(valStr, 1, 2) == ">=" then op, numStr = ">=", string.sub(valStr, 3)
    elseif string.sub(valStr, 1, 1) == "<" then op, numStr = "<", string.sub(valStr, 2)
    elseif string.sub(valStr, 1, 1) == ">" then op, numStr = ">", string.sub(valStr, 2)
    end
    
    local targetNum = tonumber(numStr)
    if not targetNum then return true end
    
    local checkVal = (isPercent and maxVal and maxVal > 0) and ((currentVal / maxVal) * 100) or currentVal
    if op == "==" then return math.abs(checkVal - targetNum) < 0.1
    elseif op == "<" then return checkVal < targetNum
    elseif op == ">" then return checkVal > targetNum
    elseif op == "<=" then return checkVal <= targetNum
    elseif op == ">=" then return checkVal >= targetNum
    end
    return true
end

local function IsPointInPart(point, part)
    if not part or not part.Parent then return false end
    local localPoint = part.CFrame:PointToObjectSpace(point)
    local size = part.Size / 2
    return math.abs(localPoint.X) <= size.X 
       and math.abs(localPoint.Y) <= size.Y 
       and math.abs(localPoint.Z) <= size.Z
end

