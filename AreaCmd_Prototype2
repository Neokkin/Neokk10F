-- MOBILE CAMERA LOCK FOR GIZMO DRAGGING
--------------------------------------------------------------------------
local IsDraggingGizmo = false
local SavedCameraType = nil

local function LockCameraForDrag()
    IsDraggingGizmo = true
    pcall(function()
        local PlayerModule = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
        if PlayerModule then
            local controls = require(PlayerModule):GetControls()
            if controls then controls:Disable() end
        end
    end)
    pcall(function()
        SavedCameraType = Camera.CameraType
        Camera.CameraType = Enum.CameraType.Scriptable
    end)
end

local function UnlockCameraForDrag()
    if not IsDraggingGizmo then return end
    IsDraggingGizmo = false
    pcall(function()
        local PlayerModule = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
        if PlayerModule then
            local controls = require(PlayerModule):GetControls()
            if controls then controls:Enable() end
        end
    end)
    pcall(function()
        if SavedCameraType then
            Camera.CameraType = SavedCameraType
            SavedCameraType = nil
        else
            Camera.CameraType = Enum.CameraType.Custom
        end
    end)
end

