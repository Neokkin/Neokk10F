local function GetDiskLoadouts()
    local names = {}
    if isfolder and listfiles and isfolder(LOADOUT_FOLDER) then
        for _, filePath in ipairs(listfiles(LOADOUT_FOLDER)) do
            local fileName = string.match(filePath, "([^/\\]+)%.json$")
            if fileName then table.insert(names, fileName) end
        end
    end
    return names
end

