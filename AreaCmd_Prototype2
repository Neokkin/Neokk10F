local LastWorldClick = 0
table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not ScreenGui.Enabled or not IsGuiOpen then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local now = tick()
        if now - LastWorldClick < 0.35 then
            local unitRay = Camera:ScreenPointToRay(input.Position.X, input.Position.Y)
            local closestArea, closestDist = nil, math.huge
            
            for _, area in ipairs(CreatedAreas) do
                if area.Part and area.Part.Parent then
                    local dist = RayBoxIntersection(unitRay.Origin, unitRay.Direction, area.Part.CFrame, area.Part.Size)
                    if dist and dist < closestDist then
                        closestDist = dist
                        closestArea = area
                    end
                end
            end
            
            if IsEditMode then
                if closestArea then
                    DeselectAllAreas()
                    SelectedArea = closestArea
                    EditBackup = AreaToData(SelectedArea)
                    if SelectedArea.Part then
                        SelectedArea.Part.Transparency = 0.5
                        SelectedArea.Part.Color = Color3.fromRGB(0, 255, 120)
                        local sb = SelectedArea.Part:FindFirstChildOfClass("SelectionBox")
                        if sb then sb.Color3 = GREEN_ACCENT end
                    end
                else
                    DeselectAllAreas()
                end
                UpdateInfoGui()
            else
                if not closestArea then
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                    local ignoreList = {GhostAreaPart}
                    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
                    raycastParams.FilterDescendantsInstances = ignoreList
                    
                    local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
                    if result then
                        SelectedArea = nil
                        local charYaw = GetCharYawCFrame()
                        GhostCFrame = CFrame.new(result.Position + Vector3.new(0, (AreaConfig.Size.Y / 2), 0)) * charYaw
                        if not GhostAreaPart then CreateGhostArea() end
                        GhostAreaPart.CFrame = GhostCFrame
                        UpdateGhostVisuals()
                    end
                    UpdateInfoGui()
                end
            end
        end
        LastWorldClick = now
    end
end))

