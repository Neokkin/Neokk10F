local function UpdateGizmos()
    if IsDraggingGizmo or not IsGuiOpen then return end
    ClearGizmos()
    local targetPart = nil
    if IsEditMode and SelectedArea and SelectedArea.Part then
        targetPart = SelectedArea.Part
    elseif not IsEditMode and GhostAreaPart then
        targetPart = GhostAreaPart
    end

    if not targetPart or not targetPart.Parent or not ScreenGui.Enabled then return end

    if DPadMode == "Pos" then
        local h = Instance.new("Handles")
        h.Name = "CmdAreaGizmo_Pos"
        h.Style = Enum.HandlesStyle.Movement
        h.Adornee = targetPart
        h.Parent = ScreenGui
        CurrentGizmo = h

        h.MouseButton1Down:Connect(function()
            DragStartCF = targetPart.CFrame
            LockCameraForDrag()
        end)

        h.MouseButton1Up:Connect(function()
            UnlockCameraForDrag()
        end)

        h.MouseDrag:Connect(function(face, distance)
            if not DragStartCF then return end
            local normal = Vector3.FromNormalId(face)
            local worldNormal = DragStartCF:VectorToWorldSpace(normal)
            local newCF = DragStartCF + (worldNormal * distance)

            if IsEditMode and SelectedArea then
                SelectedArea.CFrame = newCF
                if SelectedArea.Part then SelectedArea.Part.CFrame = newCF end
                UpdateGeyserIndicator(SelectedArea)
            elseif GhostCFrame then
                GhostCFrame = newCF
                if GhostAreaPart then GhostAreaPart.CFrame = GhostCFrame end
            end
            UpdateDPadInputText()
            UpdateInfoGui()
        end)

    elseif DPadMode == "Size" then
        local h = Instance.new("Handles")
        h.Name = "CmdAreaGizmo_Size"
        h.Style = Enum.HandlesStyle.Resize
        h.Adornee = targetPart
        h.Parent = ScreenGui
        CurrentGizmo = h

        h.MouseButton1Down:Connect(function()
            DragStartCF = targetPart.CFrame
            DragStartSize = targetPart.Size
            LockCameraForDrag()
        end)

        h.MouseButton1Up:Connect(function()
            UnlockCameraForDrag()
        end)

        h.MouseDrag:Connect(function(face, distance)
            if not DragStartSize or not DragStartCF then return end
            local normal = Vector3.FromNormalId(face)
            local absNormal = Vector3.new(math.abs(normal.X), math.abs(normal.Y), math.abs(normal.Z))
            
            local newX = math.max(1, DragStartSize.X + absNormal.X * distance)
            local newY = math.max(1, DragStartSize.Y + absNormal.Y * distance)
            local newZ = math.max(1, DragStartSize.Z + absNormal.Z * distance)
            local newSize = Vector3.new(newX, newY, newZ)

            local delta = Vector3.new(newX - DragStartSize.X, newY - DragStartSize.Y, newZ - DragStartSize.Z)
            local offsetObj = normal * (absNormal.X * delta.X + absNormal.Y * delta.Y + absNormal.Z * delta.Z) * 0.5
            local newCF = DragStartCF * CFrame.new(offsetObj)

            local target = SelectedArea or AreaConfig
            target.Size = newSize

            if IsEditMode and SelectedArea then
                SelectedArea.CFrame = newCF
                if SelectedArea.Part then
                    SelectedArea.Part.Size = newSize
                    SelectedArea.Part.CFrame = newCF
                    UpdateGeyserIndicator(SelectedArea)
                end
            elseif GhostCFrame then
                GhostCFrame = newCF
                if GhostAreaPart then
                    GhostAreaPart.Size = newSize
                    GhostAreaPart.CFrame = newCF
                end
            else
                if GhostAreaPart then GhostAreaPart.Size = newSize end
            end
            UpdateDPadInputText()
            UpdateInfoGui()
        end)

    elseif DPadMode == "Rot" then
        local ah = Instance.new("ArcHandles")
        ah.Name = "CmdAreaGizmo_Rot"
        ah.Adornee = targetPart
        ah.Parent = ScreenGui
        CurrentGizmo = ah

        ah.MouseButton1Down:Connect(function()
            DragStartCF = targetPart.CFrame
            LockCameraForDrag()
        end)

        ah.MouseButton1Up:Connect(function()
            UnlockCameraForDrag()
        end)

        ah.MouseDrag:Connect(function(axis, relativeAngle)
            if not DragStartCF then return end
            local axisVec = Vector3.FromAxis(axis)
            local rotCF = CFrame.fromAxisAngle(axisVec, relativeAngle)
            local newCF = DragStartCF * rotCF

            if IsEditMode and SelectedArea then
                SelectedArea.CFrame = newCF
                if SelectedArea.Part then SelectedArea.Part.CFrame = newCF end
                UpdateGeyserIndicator(SelectedArea)
            elseif GhostCFrame then
                GhostCFrame = newCF
                if GhostAreaPart then GhostAreaPart.CFrame = GhostCFrame end
            end
            UpdateDPadInputText()
            UpdateInfoGui()
        end)
    end
end

