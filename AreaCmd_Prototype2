local function GetCharYawCFrame()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local look = char.HumanoidRootPart.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0 then
            return CFrame.lookAt(Vector3.zero, flatLook.Unit)
        end
    end
    return CFrame.identity
end

local function DeepCopy(orig)
    local orig_type = type(orig)
    local copy
    if orig_type == 'table' then
        copy = {}
        for orig_key, orig_value in next, orig, nil do
            copy[DeepCopy(orig_key)] = DeepCopy(orig_value)
        end
    else
        copy = orig
    end
    return copy
end

local function GetGeyserVector(areaCFrame, mode)
    areaCFrame = areaCFrame or CFrame.identity
    if mode == "Air" then
        return Vector3.new(0, 1, 0)
    elseif mode == "Boost" then
        return areaCFrame.LookVector
    elseif mode == "Diagonal" then
        return (areaCFrame.LookVector + Vector3.new(0, 1, 0)).Unit
    end
    return Vector3.new(0, 1, 0)
end

local function ParseCoordinates(str, currentPos)
    if not str or str == "" then return nil end
    local parts = string.split(str, ",")
    if #parts < 3 then return nil end

    local function parseComp(part, curVal)
        part = string.gsub(part, "%s+", "")
        if string.sub(part, 1, 1) == "~" then
            local offsetStr = string.sub(part, 2)
            local offset = tonumber(offsetStr) or 0
            return curVal + offset
        else
            return tonumber(part) or curVal
        end
    end

    local x = parseComp(parts[1], currentPos.X)
    local y = parseComp(parts[2], currentPos.Y)
    local z = parseComp(parts[3], currentPos.Z)

    return Vector3.new(x, y, z)
end

local function ParseSingleYValue(str, currentY)
    if not str or str == "" then return nil end
    str = string.gsub(str, "%s+", "")
    if string.sub(str, 1, 1) == "~" then
        local offset = tonumber(string.sub(str, 2)) or 0
        return currentY + offset
    else
        return tonumber(str)
    end
end

-- MEMORY-OPTIMIZED SERIALIZATION: Saves ONLY checked & non-empty data
local function AreaToData(area)
    local savedCmds = {}
    for k, enabled in pairs(area.CommandsEnabled) do
        if enabled then
            if k == "Geyser" then
                if (area.Commands.GeyserDistance and area.Commands.GeyserDistance ~= "") or (area.Commands.GeyserStrength and area.Commands.GeyserStrength ~= "") then
                    savedCmds.GeyserDistance = area.Commands.GeyserDistance
                    savedCmds.GeyserStrength = area.Commands.GeyserStrength
                    savedCmds.GeyserMode = area.Commands.GeyserMode or "Air"
                end
            elseif k == "EdgeJump" then
                savedCmds.EdgeJump = area.Commands.EdgeJump
                savedCmds.EdgeJumpMode = area.Commands.EdgeJumpMode or "Normal"
                savedCmds.EdgeJumpStuds = area.Commands.EdgeJumpStuds or 1
            elseif k == "Jump" then
                savedCmds.Jump = area.Commands.Jump
            elseif k == "Redirect" then
                savedCmds.Redirect = area.Commands.Redirect
            elseif k == "Hallway" then
                savedCmds.Hallway = area.Commands.Hallway
            else
                local val = area.Commands[k]
                if val ~= nil and val ~= "" then
                    savedCmds[k] = val
                    if k == "TeleportWalk" then savedCmds.TeleportWalkMode = area.Commands.TeleportWalkMode end
                    if k == "Walkspeed" then savedCmds.WalkspeedMode = area.Commands.WalkspeedMode; savedCmds.WalkspeedDecay = area.Commands.WalkspeedDecay end
                    if k == "JumpPower" then savedCmds.JumpPowerMode = area.Commands.JumpPowerMode; savedCmds.JumpPowerDecay = area.Commands.JumpPowerDecay end
                    if k == "TeleportTo" then savedCmds.TeleportToMode = area.Commands.TeleportToMode; savedCmds.TeleportToTime = area.Commands.TeleportToTime end
                end
            end
        end
    end

    if area.Commands.Commandment and area.Commands.Commandment ~= "" then
        savedCmds.Commandment = area.Commands.Commandment
    end

    local savedConds = {}
    for k, v in pairs(area.Conditions or {}) do
        if v and v ~= "" then
            savedConds[k] = v
        end
    end

    return {
        Size = {X = area.Size.X, Y = area.Size.Y, Z = area.Size.Z},
        Color = {R = area.Color.R, G = area.Color.G, B = area.Color.B},
        ColorName = area.ColorName,
        IsGhostNeon = area.IsGhostNeon,
        ConditionType = area.ConditionType,
        PersistenceMode = area.PersistenceMode,
        PersistenceDuration = area.PersistenceDuration,
        Commands = savedCmds,
        CommandsEnabled = DeepCopy(area.CommandsEnabled),
        Conditions = savedConds,
        CFrame = area.CFrame and {area.CFrame:GetComponents()} or nil
    }
end

local function DataToArea(data)
    local area = DeepCopy(AreaConfig)
    area.Size = Vector3.new(data.Size.X, data.Size.Y, data.Size.Z)
    area.Color = Color3.new(data.Color.R, data.Color.G, data.Color.B)
    area.ColorName = data.ColorName
    area.IsGhostNeon = data.IsGhostNeon
    area.ConditionType = data.ConditionType or area.ConditionType
    area.PersistenceMode = data.PersistenceMode or area.PersistenceMode
    area.PersistenceDuration = data.PersistenceDuration or area.PersistenceDuration
    
    if data.Commands then
        for k, v in pairs(data.Commands) do
            area.Commands[k] = v
        end
    end
    if data.CommandsEnabled then
        for k, v in pairs(data.CommandsEnabled) do
            area.CommandsEnabled[k] = v
        end
    end
    if data.Conditions then
        for k, v in pairs(data.Conditions) do
            area.Conditions[k] = v
        end
    end

    if area.Commands.EdgeJumpMode == nil then area.Commands.EdgeJumpMode = "Normal" end
    if area.Commands.EdgeJumpStuds == nil then area.Commands.EdgeJumpStuds = 1 end
    if area.Commands.TeleportWalkMode == nil then area.Commands.TeleportWalkMode = "Smooth" end
    if area.Commands.WalkspeedMode == nil then area.Commands.WalkspeedMode = "Linear" end
    if area.Commands.WalkspeedDecay == nil then area.Commands.WalkspeedDecay = 3 end
    if area.Commands.JumpPowerMode == nil then area.Commands.JumpPowerMode = "Linear" end
    if area.Commands.JumpPowerDecay == nil then area.Commands.JumpPowerDecay = 3 end
    if area.Commands.TeleportToMode == nil then area.Commands.TeleportToMode = "Instant" end
    if area.Commands.TeleportToTime == nil then area.Commands.TeleportToTime = 2 end
    if area.Commands.GeyserMode == nil then area.Commands.GeyserMode = "Air" end

    if data.CFrame then
        area.CFrame = CFrame.new(unpack(data.CFrame))
    end
    return area
end

local function UpdateGeyserIndicator(area)
    if not area or not area.Part or not area.Part.Parent then return end
    
    local geyserActive = area.CommandsEnabled and area.CommandsEnabled.Geyser and 
        (tonumber(area.Commands.GeyserDistance) or tonumber(area.Commands.GeyserStrength))
    local redirectActive = area.CommandsEnabled and area.CommandsEnabled.Redirect and area.Commands.Redirect
    local hallwayActive = area.CommandsEnabled and area.CommandsEnabled.Hallway and area.Commands.Hallway

    local existingGeyser = area.Part:FindFirstChild("GeyserIndicator")
    local existingRedirect = area.Part:FindFirstChild("RedirectIndicator")
    local leftWall = area.Part:FindFirstChild("HallwayLeftWall")
    local rightWall = area.Part:FindFirstChild("HallwayRightWall")
    
    if not geyserActive and existingGeyser then
        existingGeyser:Destroy()
        existingGeyser = nil
    end

    if not redirectActive and existingRedirect then
        existingRedirect:Destroy()
        existingRedirect = nil
    end

    if not hallwayActive then
        if leftWall then leftWall:Destroy() end
        if rightWall then rightWall:Destroy() end
        leftWall = nil
        rightWall = nil
    end

    local cf = area.CFrame or area.Part.CFrame
    local size = area.Size or area.Part.Size

    if hallwayActive then
        if not leftWall then
            leftWall = Instance.new("Part")
            leftWall.Name = "HallwayLeftWall"
            leftWall.Anchored = true
            leftWall.CanCollide = true
            leftWall.CanTouch = false
            leftWall.CanQuery = false
            leftWall.Transparency = 1
            leftWall.Parent = area.Part
        end

        if not rightWall then
            rightWall = Instance.new("Part")
            rightWall.Name = "HallwayRightWall"
            rightWall.Anchored = true
            rightWall.CanCollide = true
            rightWall.CanTouch = false
            rightWall.CanQuery = false
            rightWall.Transparency = 1
            rightWall.Parent = area.Part
        end

        leftWall.Size = Vector3.new(0.5, size.Y, size.Z)
        leftWall.CFrame = cf * CFrame.new(-size.X / 2, 0, 0)

        rightWall.Size = Vector3.new(0.5, size.Y, size.Z)
        rightWall.CFrame = cf * CFrame.new(size.X / 2, 0, 0)
    end

    if geyserActive then
        if not existingGeyser then
            existingGeyser = Instance.new("WedgePart")
            existingGeyser.Name = "GeyserIndicator"
            existingGeyser.Anchored = true
            existingGeyser.CanCollide = false
            existingGeyser.CanTouch = false
            existingGeyser.CanQuery = false
            existingGeyser.Material = Enum.Material.Neon
            existingGeyser.Color = Color3.fromRGB(255, 180, 0)
            existingGeyser.Transparency = 0.2
            existingGeyser.Parent = area.Part
        end

        local mode = area.Commands.GeyserMode or "Air"
        local vec = GetGeyserVector(cf, mode)
        existingGeyser.Size = Vector3.new(2, 2, 4)
        existingGeyser.CFrame = CFrame.lookAt(cf.Position, cf.Position + vec)
    end

    if redirectActive then
        if not existingRedirect then
            existingRedirect = Instance.new("WedgePart")
            existingRedirect.Name = "RedirectIndicator"
            existingRedirect.Anchored = true
            existingRedirect.CanCollide = false
            existingRedirect.CanTouch = false
            existingRedirect.CanQuery = false
            existingRedirect.Material = Enum.Material.Neon
            existingRedirect.Color = Color3.fromRGB(180, 0, 255) -- Purple color for Redirect
            existingRedirect.Transparency = 0.2
            existingRedirect.Parent = area.Part
        end

        -- Position redirect arrow below geyser arrow if both exist
        local redirectPos = cf.Position
        if geyserActive then
            redirectPos = cf.Position - (cf.UpVector * 2.2)
        end

        existingRedirect.Size = Vector3.new(2, 2, 4)
        existingRedirect.CFrame = CFrame.lookAt(redirectPos, redirectPos + cf.LookVector)
    end
end

