    if data.CommandsEnabled.Jump and data.Commands.Jump then table.insert(cmds, "Jump") end
    if data.CommandsEnabled.TeleportTo and data.Commands.TeleportTo then
        local tpMode = data.Commands.TeleportToMode or "Instant"
        local extraInfo = (tpMode == "Tween" or tpMode == "Curve") and (" " .. (data.Commands.TeleportToTime or 2) .. "s") or ""
        table.insert(cmds, "TP To: " .. data.Commands.TeleportTo .. " (" .. tpMode .. extraInfo .. ")")
    end
    if data.CommandsEnabled.Gravity and data.Commands.Gravity then table.insert(cmds, "Grav: " .. data.Commands.Gravity) end
    if data.CommandsEnabled.HipHeight and data.Commands.HipHeight then table.insert(cmds, "HipH: " .. data.Commands.HipHeight) end
    if data.CommandsEnabled.AirWalkHeight and data.Commands.AirWalkHeight then table.insert(cmds, "AirWalk: " .. data.Commands.AirWalkHeight) end
    if data.CommandsEnabled.Geyser and (data.Commands.GeyserDistance or data.Commands.GeyserStrength) then
        table.insert(cmds, "Geyser: " .. (data.Commands.GeyserDistance or "?") .. "st / " .. (data.Commands.GeyserStrength or "?") .. "spd (" .. (data.Commands.GeyserMode or "Air") .. ")")
    end
    if data.CommandsEnabled.Redirect and data.Commands.Redirect then table.insert(cmds, "Redirect") end
    if data.CommandsEnabled.Hallway and data.Commands.Hallway then table.insert(cmds, "Hallway") end
    if data.Commands.Commandment and data.Commands.Commandment ~= "" then table.insert(cmds, "Script Attached") end

    InfoRows.Commands.Text = "Cmds: " .. (#cmds > 0 and table.concat(cmds, ", ") or "None")
    
    local conds = {}
    if data.Conditions.Hp and data.Conditions.Hp ~= "" then table.insert(conds, "HP " .. data.Conditions.Hp) end
    if data.Conditions.Walkspeed and data.Conditions.Walkspeed ~= "" then table.insert(conds, "WS " .. data.Conditions.Walkspeed) end
    if data.Conditions.JumpPower and data.Conditions.JumpPower ~= "" then table.insert(conds, "JP " .. data.Conditions.JumpPower) end
    InfoRows.Conditions.Text = "Conds: " .. (#conds > 0 and table.concat(conds, ", ") or "None")
    
    InfoScroll.CanvasSize = UDim2.new(0, 0, 0, InfoLayout.AbsoluteContentSize.Y + 10)
    
    DPadFrame.Visible = (IsEditMode and SelectedArea ~= nil) or (not IsEditMode and GhostCFrame ~= nil)
    UpdateDPadInputText()
    if not IsDraggingGizmo then
        UpdateGizmos()
    end
    RefreshCmdsPopup()
end

