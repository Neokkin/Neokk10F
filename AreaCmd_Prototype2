local EdgeJumpPlatforms = {}
local LastEmpoweredSpawn = 0

local function ClearEdgeJumpPlatforms()
    for _, p in ipairs(EdgeJumpPlatforms) do
        if p and p.Parent then p:Destroy() end
    end
    EdgeJumpPlatforms = {}
end

local function GetRayParams(char)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {char}
    for _, p in ipairs(EdgeJumpPlatforms) do
        if p and p.Parent then
            table.insert(filterList, p)
        end
    end
    rayParams.FilterDescendantsInstances = filterList
    return rayParams
end

local function DoEdgeJump(char, hum, hrp, mode, studs)
    if hum.MoveDirection.Magnitude <= 0 then return end

    local state = hum:GetState()
    if state ~= Enum.HumanoidStateType.Running and state ~= Enum.HumanoidStateType.RunningNoPhysics and hum.FloorMaterial == Enum.Material.Air then
        return
    end

    local moveDir = hum.MoveDirection.Unit
    local rayParams = GetRayParams(char)

    local downRayOrigin = hrp.Position
    local downResult = workspace:Raycast(downRayOrigin, Vector3.new(0, -5, 0), rayParams)

    if mode == "Normal" then
        local aheadOrigin = hrp.Position + (moveDir * 1.5)
        local aheadResult = workspace:Raycast(aheadOrigin, Vector3.new(0, -5, 0), rayParams)
        if not aheadResult and downResult then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end

    elseif mode == "Empowered" then
        local extraOffset = math.max(1, studs or 1)

        if downResult then
            local aheadOrigin = hrp.Position + (moveDir * 1.5)
            local aheadResult = workspace:Raycast(aheadOrigin, Vector3.new(0, -5, 0), rayParams)

            if not aheadResult then
                if tick() - LastEmpoweredSpawn > 0.5 then
                    LastEmpoweredSpawn = tick()

                    local groundY = downResult.Position.Y
                    local startPos = Vector3.new(hrp.Position.X, groundY - 0.25, hrp.Position.Z)
                    local centerPos = startPos + (moveDir * (extraOffset / 2 + 0.5))
                    local lookPos = centerPos + moveDir

                    local platform = Instance.new("Part")
                    platform.Name = "CmdEdgePlatform"
                    platform.Size = Vector3.new(4, 0.5, extraOffset + 1)
                    platform.CFrame = CFrame.lookAt(centerPos, lookPos)
                    platform.Anchored = true
                    platform.CanCollide = true
                    platform.Transparency = 0.6
                    platform.Color = Color3.fromRGB(0, 230, 255)
                    platform.Material = Enum.Material.SmoothPlastic
                    platform.Parent = workspace
                    table.insert(EdgeJumpPlatforms, platform)

                    task.delay(1.5, function()
                        if platform and platform.Parent then platform:Destroy() end
                        for i, p in ipairs(EdgeJumpPlatforms) do
                            if p == platform then table.remove(EdgeJumpPlatforms, i) break end
                        end
                    end)
                end
            end
        else
            local aheadOrigin = hrp.Position + (moveDir * 1.5)
            local fullRayParams = RaycastParams.new()
            fullRayParams.FilterType = Enum.RaycastFilterType.Exclude
            fullRayParams.FilterDescendantsInstances = {char}
            local platformAheadResult = workspace:Raycast(aheadOrigin, Vector3.new(0, -5, 0), fullRayParams)

            if not platformAheadResult then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end

local function EnsureAirWalkPlatform(yPos)
    if not AirWalkPlatformPart or not AirWalkPlatformPart.Parent then
