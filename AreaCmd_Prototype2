-- PROPER SYNCING ON EDITING AREA & CUSTOM COMMANDS POPULATION
RefreshCmdsPopup = function()
    local target = SelectedArea or AreaConfig
    for key, entry in pairs(CmdInputs) do
        local enabled = target.CommandsEnabled[key] or false
        if entry.BtnSwitch then
            entry.BtnSwitch.Text = enabled and "✓" or "✕"
            entry.BtnSwitch.BackgroundColor3 = enabled and Color3.fromRGB(0, 160, 80) or Color3.fromRGB(180, 40, 40)
        end

        if key == "Geyser" then
            if entry.BoxDist then entry.BoxDist.Text = target.Commands.GeyserDistance and tostring(target.Commands.GeyserDistance) or "" end
            if entry.BoxStr then entry.BoxStr.Text = target.Commands.GeyserStrength and tostring(target.Commands.GeyserStrength) or "" end
        else
            if entry.Box then
                if key == "TeleportTo" or key == "AirWalkHeight" then
                    entry.Box.Text = target.Commands[key] or ""
                else
                    entry.Box.Text = target.Commands[key] and tostring(target.Commands[key]) or ""
                end
            end
        end

        if entry.BoxSec then
            entry.BoxSec.Text = tostring(target.Commands.TeleportToTime or 2)
        end

        if entry.BoxDecay and entry.DecayKey then
            local decayVal = target.Commands[entry.DecayKey] or 3
            entry.BoxDecay.Text = tostring(decayVal)
            local curMode = target.Commands[entry.ModeKey] or entry.DefaultMode
            entry.BoxDecay.Visible = (curMode == "Curve")
        end

        if entry.BoxStuds then
            local studsVal = target.Commands.EdgeJumpStuds or 1
            entry.BoxStuds.Text = tostring(studsVal)
            local curMode = target.Commands.EdgeJumpMode or "Normal"
            entry.BoxStuds.Visible = (curMode == "Empowered")
        end

        if entry.BtnMode and entry.ModeKey then
            local mode = target.Commands[entry.ModeKey] or entry.DefaultMode
            entry.BtnMode.Text = mode
            if mode == "Linear" or mode == "Normal" or mode == "Air" then entry.BtnMode.BackgroundColor3 = Color3.fromRGB(0, 140, 100)
            elseif mode == "Curve" or mode == "Empowered" or mode == "Boost" then entry.BtnMode.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
            elseif mode == "Smooth" or mode == "Diagonal" then entry.BtnMode.BackgroundColor3 = Color3.fromRGB(0, 120, 180)
            elseif mode == "Instant" then entry.BtnMode.BackgroundColor3 = Color3.fromRGB(180, 100, 0)
            elseif mode == "Tween" then entry.BtnMode.BackgroundColor3 = Color3.fromRGB(140, 0, 180) end
        end

        if entry.ToggleBtn then
            local state = target.Commands[key] or false
            entry.ToggleBtn.Text = entry.Label .. ": " .. (state and "ON" or "OFF")
            entry.ToggleBtn.BackgroundColor3 = state and Color3.fromRGB(0, 120, 60) or PANEL_DARK
        end
    end

    -- POPULATE CUSTOM COMMANDS IN DROPDOWN
    for _, child in ipairs(CustomCmdsContainer:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end

    if #CustomCommands == 0 then
        local emptyCustomLbl = Instance.new("TextLabel")
        emptyCustomLbl.Size = UDim2.new(1, 0, 0, 22)
        emptyCustomLbl.BackgroundTransparency = 1
        emptyCustomLbl.Text = "No custom commands created yet."
        emptyCustomLbl.TextColor3 = Color3.fromRGB(140, 140, 150)
        emptyCustomLbl.TextSize = 10
        emptyCustomLbl.Font = Enum.Font.SourceSansItalic
        emptyCustomLbl.Parent = CustomCmdsContainer
    else
        for idx, cmdData in ipairs(CustomCommands) do
            local customRow = Instance.new("Frame")
            customRow.Size = UDim2.new(1, 0, 0, 28)
            customRow.BackgroundTransparency = 1
            customRow.Parent = CustomCmdsContainer

            local isCustomEnabled = target.CommandsEnabled[cmdData.Name] or false

            local btnCustomSwitch = Instance.new("TextButton")
            btnCustomSwitch.Size = UDim2.new(0, 24, 1, 0)
            btnCustomSwitch.Position = UDim2.new(0, 0, 0, 0)
            btnCustomSwitch.BackgroundColor3 = isCustomEnabled and Color3.fromRGB(0, 160, 80) or Color3.fromRGB(180, 40, 40)
            btnCustomSwitch.Text = isCustomEnabled and "✓" or "✕"
            btnCustomSwitch.TextColor3 = TEXT_COLOR
            btnCustomSwitch.TextSize = 12
            btnCustomSwitch.Font = Enum.Font.SourceSansBold
            btnCustomSwitch.Parent = customRow
            MakeCorner(btnCustomSwitch, 4)

            local lblCustomName = Instance.new("TextLabel")
            lblCustomName.Size = UDim2.new(1, -30, 1, 0)
            lblCustomName.Position = UDim2.new(0, 28, 0, 0)
            lblCustomName.BackgroundColor3 = PANEL_DARK
            lblCustomName.Text = " " .. (cmdData.Name or ("CustomCmd_" .. idx))
            lblCustomName.TextColor3 = TEXT_COLOR
            lblCustomName.TextSize = 11
            lblCustomName.Font = Enum.Font.SourceSansBold
            lblCustomName.TextXAlignment = Enum.TextXAlignment.Left
            lblCustomName.Parent = customRow
            MakeCorner(lblCustomName, 4)

            btnCustomSwitch.MouseButton1Click:Connect(function()
                target.CommandsEnabled[cmdData.Name] = not target.CommandsEnabled[cmdData.Name]
                if target.CommandsEnabled[cmdData.Name] then
                    target.Commands[cmdData.Name] = cmdData.Code
                end
                RefreshCmdsPopup()
                UpdateInfoGui()
            end)
        end
    end

    PopCmdsScroll.CanvasSize = UDim2.new(0, 0, 0, CmdsList.AbsoluteContentSize.Y + 20)
end

