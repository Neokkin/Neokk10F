    end
end

local function DestroyAirWalkPlatform()
    if AirWalkPlatformPart then
        AirWalkPlatformPart:Destroy()
        AirWalkPlatformPart = nil
    end
end

-- RENDERSTEPPED MOVEMENT ENGINE
table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    -- TELEPORT WALK EXECUTION
    if ActiveTeleportWalk and type(ActiveTeleportWalk) == "number" and ActiveTeleportWalk > 0 then
        if hum.MoveDirection.Magnitude > 0 then
            if ActiveTeleportWalkMode == "Instant" then
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection * ActiveTeleportWalk)
            else
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (ActiveTeleportWalk * dt * 30))
            end
        end
    end

    -- TELEPORT TO EXECUTION
    if ActiveTeleportTo and type(ActiveTeleportTo) == "string" and ActiveTeleportTo ~= "" then
        local targetPos = ParseCoordinates(ActiveTeleportTo, hrp.Position)
        if targetPos then
            if ActiveTeleportToMode == "Instant" then
                hrp.CFrame = CFrame.new(targetPos)
            elseif ActiveTeleportToMode == "Smooth" then
                hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(targetPos), math.clamp(dt * 10, 0, 1))
            elseif ActiveTeleportToMode == "Tween" or ActiveTeleportToMode == "Curve" then
                if ActiveTeleportToState.TargetPos ~= targetPos or ActiveTeleportToState.Mode ~= ActiveTeleportToMode then
                    ActiveTeleportToState.TargetPos = targetPos
                    ActiveTeleportToState.StartPos = hrp.Position
                    ActiveTeleportToState.StartTime = tick()
                    ActiveTeleportToState.Duration = ActiveTeleportToTime or 2
                    ActiveTeleportToState.Mode = ActiveTeleportToMode
                end

                local elapsed = tick() - ActiveTeleportToState.StartTime
                local duration = math.max(0.05, ActiveTeleportToState.Duration)
                local alpha = math.clamp(elapsed / duration, 0, 1)

                if ActiveTeleportToMode == "Curve" then
                    alpha = 0.5 - 0.5 * math.cos(math.pi * alpha)
                end

                local curPos = ActiveTeleportToState.StartPos:Lerp(targetPos, alpha)
                hrp.CFrame = CFrame.new(curPos)
            end
        end
    else
        ActiveTeleportToState.TargetPos = nil
    end

    -- AIR WALK HEIGHT PLATFORM
    if ActiveAirWalkY then
        EnsureAirWalkPlatform(ActiveAirWalkY)
        AirWalkPlatformPart.CFrame = CFrame.new(hrp.Position.X, ActiveAirWalkY - 0.5, hrp.Position.Z)
    else
        DestroyAirWalkPlatform()
    end

    if ActiveEdgeJump then 
        DoEdgeJump(char, hum, hrp, ActiveEdgeJumpMode, ActiveEdgeJumpStuds) 
    end
end))

local function ProcessCurveStat(key, targetVal, mode, decayRate, hum, defaultVal, dt)
    local stateKey = key
    if not CurveStates[stateKey] then
        CurveStates[stateKey] = {
            currentVal = defaultVal or 16
        }
    end

    local st = CurveStates[stateKey]
    if mode == "Linear" then
        st.currentVal = targetVal
        return targetVal
    else
        local lerpSpeed = math.clamp(dt * (decayRate or 3), 0, 1)
        st.currentVal = st.currentVal + (targetVal - st.currentVal) * lerpSpeed
        return st.currentVal
    end
end

-- MAIN HEARTBEAT AREA PROCESSOR
table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    CaptureOriginalState()

    local insideAnyArea = false
    local currentAreaObj = nil

    for _, area in ipairs(CreatedAreas) do
        if area.Part and area.Part.Parent then
            local isInside = IsPointInPart(hrp.Position, area.Part)
            if isInside then
                local maxHp = hum.MaxHealth
                local curHp = hum.Health
                local hpOk = ParseCondition(area.Conditions.Hp, curHp, maxHp)
                local wsOk = ParseCondition(area.Conditions.Walkspeed, hum.WalkSpeed, 100)
                local jpOk = ParseCondition(area.Conditions.JumpPower, hum.JumpPower, 200)

                if hpOk and wsOk and jpOk then
                    insideAnyArea = true
                    currentAreaObj = area
                    break
                end
            end
        end
    end

local function ExecuteRedirect(area)
    if not hrp then return end
    local cf = area.CFrame or (area.Part and area.Part.CFrame)
    if not cf then return end

    local targetLook = cf.LookVector

    -- Force rotate character facing direction
    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + targetLook)

    -- Force rotate camera facing direction
    if Camera then
        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.lookAt(camPos, camPos + targetLook)
    end
end

if insideAnyArea and currentAreaObj then
    local cmds = currentAreaObj.Commands
    local enabled = currentAreaObj.CommandsEnabled

    if enabled.TeleportWalk then ActiveTeleportWalk = cmds.TeleportWalk; ActiveTeleportWalkMode = cmds.TeleportWalkMode or "Smooth" else ActiveTeleportWalk = nil end
    if enabled.Walkspeed and cmds.Walkspeed then
        local wsVal = ProcessCurveStat("Walkspeed", cmds.Walkspeed, cmds.WalkspeedMode, cmds.WalkspeedDecay, hum, OriginalState.WalkSpeed, dt)
        hum.WalkSpeed = wsVal
    end
    if enabled.JumpPower and cmds.JumpPower then
        local jpVal = ProcessCurveStat("JumpPower", cmds.JumpPower, cmds.JumpPowerMode, cmds.JumpPowerDecay, hum, OriginalState.JumpPower, dt)
        hum.UseJumpPower = true
        hum.JumpPower = jpVal
    end
    if enabled.Gravity and cmds.Gravity then workspace.Gravity = cmds.Gravity end
    if enabled.HipHeight and cmds.HipHeight then hum.HipHeight = cmds.HipHeight end
    if enabled.AirWalkHeight and cmds.AirWalkHeight then
        ActiveAirWalkY = ParseSingleYValue(cmds.AirWalkHeight, hrp.Position.Y)
    else
        ActiveAirWalkY = nil
    end

    if enabled.EdgeJump then ActiveEdgeJump = cmds.EdgeJump; ActiveEdgeJumpMode = cmds.EdgeJumpMode; ActiveEdgeJumpStuds = cmds.EdgeJumpStuds else ActiveEdgeJump = false end
    if enabled.Jump and cmds.Jump then
        hum.Jump = true
        if hum.FloorMaterial ~= Enum.Material.Air then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
    if enabled.Redirect and cmds.Redirect then
        ExecuteRedirect(currentAreaObj)
    end
    if enabled.TeleportTo then ActiveTeleportTo = cmds.TeleportTo; ActiveTeleportToMode = cmds.TeleportToMode; ActiveTeleportToTime = cmds.TeleportToTime else ActiveTeleportTo = nil end

        -- GEYSER COMMAND EXECUTION
        if enabled.Geyser and (cmds.GeyserDistance or cmds.GeyserStrength) then
            local dist = tonumber(cmds.GeyserDistance) or 50
            local str = tonumber(cmds.GeyserStrength) or 100
            local mode = cmds.GeyserMode or "Air"

            if dist > 0 and str > 0 and not ActiveGeyserDebounce[currentAreaObj] then
                ActiveGeyserDebounce[currentAreaObj] = true
                task.spawn(function()
                    local dir = GetGeyserVector(currentAreaObj.CFrame or currentAreaObj.Part.CFrame, mode)
                    local duration = math.clamp(dist / str, 0.05, 5)

                    local bv = Instance.new("BodyVelocity")
                    bv.Name = "CmdGeyserVelocity"
                    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                    bv.Velocity = dir * str
                    bv.Parent = hrp

                    local startT = tick()
                    while tick() - startT < duration do
                        RunService.Heartbeat:Wait()
                        if not hrp or not hrp.Parent then break end
                        local curVec = GetGeyserVector(currentAreaObj.CFrame or currentAreaObj.Part.CFrame, mode)
                        bv.Velocity = curVec * str
                    end

                    if bv and bv.Parent then bv:Destroy() end
                    task.wait(0.3)
                    ActiveGeyserDebounce[currentAreaObj] = nil
                end)
            end
        end

        if cmds.Commandment and cmds.Commandment ~= "" and not ExecutedCommandments[currentAreaObj] then
            ExecutedCommandments[currentAreaObj] = true
            task.spawn(function()
                local fn, err = loadstring(cmds.Commandment)
                if fn then pcall(fn) else warn("Commandment error:", err) end
            end)
        end
    else
        ActiveTeleportWalk = nil
        ActiveTeleportTo = nil
        ActiveEdgeJump = false
        ActiveAirWalkY = nil
        RevertToOriginalState()
    end
end))

