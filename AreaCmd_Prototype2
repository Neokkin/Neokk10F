local function PositionPopupAboveButton(pop, btn)
    pop.AnchorPoint = Vector2.new(0.5, 1)
    local btnCenter = btn.AbsolutePosition.X + (btn.AbsoluteSize.X / 2)
    local btnTop = btn.AbsolutePosition.Y
    local popWidth, popHeight = pop.Size.X.Offset, pop.Size.Y.Offset
    local targetY = math.max(10 + popHeight, btnTop - 6)
    local viewportSize = Camera and Camera.ViewportSize or Vector2.new(1000, 600)
    btnCenter = math.clamp(btnCenter, (popWidth / 2) + 10, viewportSize.X - (popWidth / 2) - 10)
    pop.Position = UDim2.fromOffset(btnCenter, targetY)
end

local function TogglePopup(pop, btn)
    if ActivePopup == pop then ClosePopups()
    else
        ClosePopups()
        if btn then PositionPopupAboveButton(pop, btn) end
        pop.Visible = true
        ActivePopup = pop
    end
end

