local function PerformDPadAction(dirKey)
    local isTargetGhost = (not IsEditMode and GhostCFrame ~= nil)
    local isTargetEdit = (IsEditMode and SelectedArea ~= nil)
    if not isTargetGhost and not isTargetEdit then return end

    if DPadMode == "Pos" then
        local MOVE_STEP = 1.5
        local moveVec = Vector3.zero
        
        if IsVerticalMovement then
            if dirKey == "Up" then moveVec = Vector3.new(0, MOVE_STEP, 0)
            elseif dirKey == "Down" then moveVec = Vector3.new(0, -MOVE_STEP, 0)
            end
        else
            local camCF = Camera.CFrame
            local look = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            look = (look.Magnitude > 0) and look.Unit or Vector3.new(0, 0, -1)
            
            local right = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
            right = (right.Magnitude > 0) and right.Unit or Vector3.new(1, 0, 0)
            
            if dirKey == "Up" then moveVec = look * MOVE_STEP
            elseif dirKey == "Down" then moveVec = -look * MOVE_STEP
            elseif dirKey == "Left" then moveVec = -right * MOVE_STEP
            elseif dirKey == "Right" then moveVec = right * MOVE_STEP
            end
        end
        
        if moveVec ~= Vector3.zero then
            if isTargetEdit then
                SelectedArea.CFrame = (SelectedArea.CFrame or CFrame.identity) + moveVec
                if SelectedArea.Part then SelectedArea.Part.CFrame = SelectedArea.CFrame end
                UpdateGeyserIndicator(SelectedArea)
            elseif isTargetGhost then
                GhostCFrame = GhostCFrame + moveVec
                if GhostAreaPart then GhostAreaPart.CFrame = GhostCFrame end
            end
        end

    elseif DPadMode == "Size" then
        local SIZE_STEP = 2
        local targetSize = (isTargetEdit and SelectedArea.Size) or AreaConfig.Size
        local dx, dy, dz = 0, 0, 0

        if IsVerticalMovement then
            if dirKey == "Up" then dy = SIZE_STEP
            elseif dirKey == "Down" then dy = -SIZE_STEP
            end
        else
            if dirKey == "Up" then dz = SIZE_STEP
            elseif dirKey == "Down" then dz = -SIZE_STEP
            elseif dirKey == "Right" then dx = SIZE_STEP
            elseif dirKey == "Left" then dx = -SIZE_STEP
            end
        end

        local newSize = Vector3.new(
            math.max(1, targetSize.X + dx),
            math.max(1, targetSize.Y + dy),
            math.max(1, targetSize.Z + dz)
        )

        if isTargetEdit then
            SelectedArea.Size = newSize
            if SelectedArea.Part then SelectedArea.Part.Size = newSize end
            UpdateGeyserIndicator(SelectedArea)
        else
            AreaConfig.Size = newSize
            if GhostAreaPart then GhostAreaPart.Size = newSize end
        end

    elseif DPadMode == "Rot" then
        local ROT_STEP = math.rad(15)
        local rotDelta = CFrame.identity

        if IsVerticalMovement then
            if dirKey == "Up" then rotDelta = CFrame.Angles(ROT_STEP, 0, 0)
            elseif dirKey == "Down" then rotDelta = CFrame.Angles(-ROT_STEP, 0, 0)
            end
        else
            if dirKey == "Left" then rotDelta = CFrame.Angles(0, ROT_STEP, 0)
            elseif dirKey == "Right" then rotDelta = CFrame.Angles(0, -ROT_STEP, 0)
            elseif dirKey == "Up" then rotDelta = CFrame.Angles(0, 0, ROT_STEP)
            elseif dirKey == "Down" then rotDelta = CFrame.Angles(0, 0, -ROT_STEP)
            end
        end

        if rotDelta ~= CFrame.identity then
            if isTargetEdit then
                local pos = SelectedArea.CFrame and SelectedArea.CFrame.Position or Vector3.zero
                SelectedArea.CFrame = CFrame.new(pos) * (SelectedArea.CFrame.Rotation * rotDelta)
                if SelectedArea.Part then SelectedArea.Part.CFrame = SelectedArea.CFrame end
                UpdateGeyserIndicator(SelectedArea)
            elseif isTargetGhost then
                local pos = GhostCFrame.Position
                GhostCFrame = CFrame.new(pos) * (GhostCFrame.Rotation * rotDelta)
                if GhostAreaPart then GhostAreaPart.CFrame = GhostCFrame end
            end
        end
    end

    UpdateInfoGui()
    UpdateDPadInputText()
    UpdateGizmos()
end

