-- Helper: Helper to parse CFrame/Position input string
local function parseCFrameString(str)
	if not str or str == "" then return nil end
	local nums = {}
	for num in string.gmatch(str, "[-+]?%d*%.?%d+") do
		table.insert(nums, tonumber(num))
	end
	if #nums >= 12 then
		return CFrame.new(unpack(nums, 1, 12))
	elseif #nums >= 3 then
		return CFrame.new(nums[1], nums[2], nums[3])
	end
	return nil
end

-- Helper: Create Void Theme Pop-up Window
local function createPopupWindow(titleText, size)
	local popupName = "VoidModal_" .. titleText:gsub("%s+", "")
	local oldModal = PlayerGui:FindFirstChild(popupName)
	if oldModal then oldModal:Destroy() end

	local modalFrame = Instance.new("Frame")
	modalFrame.Name = popupName
	modalFrame.Size = size or UDim2.new(0, 320, 0, 180)
	modalFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	modalFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	modalFrame.BackgroundColor3 = Color3.fromRGB(15, 10, 25)
	modalFrame.BorderSizePixel = 0
	modalFrame.ZIndex = 1000
	modalFrame.Parent = PlayerGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = modalFrame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(190, 50, 255)
	stroke.Thickness = 2
	stroke.Parent = modalFrame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -40, 0, 40)
	title.Position = UDim2.new(0, 15, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = titleText
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 14
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 1001
	title.Parent = modalFrame

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.new(0, 26, 0, 26)
	closeBtn.Position = UDim2.new(1, -32, 0, 7)
	closeBtn.Text = "×"
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 18
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	closeBtn.ZIndex = 1001
	closeBtn.Parent = modalFrame
	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)

	closeBtn.Activated:Connect(function()
		modalFrame:Destroy()
	end)

	return modalFrame
end

-- Helper: CustomPos CFrame Input GUI
local function openCustomPosGUI()
	local modal = createPopupWindow("Custom CFrame Destination", UDim2.new(0, 320, 0, 180))

	local inputBox = Instance.new("TextBox")
	inputBox.Size = UDim2.new(1, -30, 0, 38)
	inputBox.Position = UDim2.new(0, 15, 0, 48)
	inputBox.PlaceholderText = "e.g., 100, 50, -200 OR 12 CFrame numbers"
	inputBox.Text = tostring(SystemState.CustomPosCFrame)
	inputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	inputBox.BackgroundColor3 = Color3.fromRGB(28, 18, 42)
	inputBox.Font = Enum.Font.Gotham
	inputBox.TextSize = 10
	inputBox.ClearTextOnFocus = false
	inputBox.ZIndex = 1001
	inputBox.Parent = modal
	
	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = Color3.fromRGB(230, 120, 255)
	boxStroke.Thickness = 1.5
	boxStroke.Parent = inputBox
	Instance.new("UICorner", inputBox).CornerRadius = UDim.new(0, 6)

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(1, -120, 0, 32)
	statusLabel.Position = UDim2.new(0, 15, 1, -42)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Text = ""
	statusLabel.TextColor3 = Color3.fromRGB(200, 180, 220)
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.TextSize = 11
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.ZIndex = 1001
	statusLabel.Parent = modal

	local saveBtn = Instance.new("TextButton")
	saveBtn.Size = UDim2.new(0, 85, 0, 32)
	saveBtn.AnchorPoint = Vector2.new(1, 1)
	saveBtn.Position = UDim2.new(1, -15, 1, -10)
	saveBtn.Text = "Save"
	saveBtn.Font = Enum.Font.GothamBold
	saveBtn.TextSize = 13
	saveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	saveBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 120)
	saveBtn.ZIndex = 1001
	saveBtn.Parent = modal
	Instance.new("UICorner", saveBtn).CornerRadius = UDim.new(0, 6)

	local function saveCFrame()
		local parsed = parseCFrameString(inputBox.Text)
		if parsed then
			SystemState.CustomPosCFrame = parsed
			statusLabel.TextColor3 = Color3.fromRGB(50, 200, 120)
			statusLabel.Text = "CFrame Saved!"
			task.delay(0.8, function()
				if modal and modal.Parent then modal:Destroy() end
			end)
		else
			statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			statusLabel.Text = "Invalid CFrame!"
		end
	end

	saveBtn.Activated:Connect(saveCFrame)
	inputBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then saveCFrame() end
	end)
end

