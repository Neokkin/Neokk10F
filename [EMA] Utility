local selectedUpper = {}
local selectedLower = {}

local function refreshGrudgeGUI()
	for _, c in ipairs(upperScroll:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	for _, c in ipairs(lowerScroll:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end

	local currentPlrs = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(currentPlrs, p) end
	end
	table.sort(currentPlrs, function(a,b) return a.Name:lower() < b.Name:lower() end)

	for _, p in ipairs(currentPlrs) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -6, 0, 28)
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 11
		btn.Text = string.format("  [%s] | [%s]", p.Name, p.DisplayName)
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.TextColor3 = THEME.TextWhite
		btn.ZIndex = 1003
		btn.Parent = upperScroll

		local isSel = selectedUpper[p]
		applyVoidStyle(btn, isSel and THEME.Selected or THEME.AccentNeon)
		if isSel then btn.BackgroundColor3 = Color3.fromRGB(25, 60, 40) end

		bindAction(btn, function()
			selectedUpper[p] = not selectedUpper[p]
			refreshGrudgeGUI()
		end)
	end
	upperScroll.CanvasSize = UDim2.new(0, 0, 0, #currentPlrs * 32)

	local grudgeKeys = {}
	for username, nick in pairs(Grudges) do
		table.insert(grudgeKeys, { Name = username, Nick = nick })
	end
	table.sort(grudgeKeys, function(a,b) return a.Name:lower() < b.Name:lower() end)

	for _, item in ipairs(grudgeKeys) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -6, 0, 28)
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 11
		btn.Text = string.format("  [%s] | [%s]", item.Name, item.Nick)
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.TextColor3 = THEME.TextWhite
		btn.ZIndex = 1003
		btn.Parent = lowerScroll

		local isSel = selectedLower[item.Name]
		applyVoidStyle(btn, isSel and Color3.fromRGB(200, 60, 60) or THEME.AccentNeon)
		if isSel then btn.BackgroundColor3 = Color3.fromRGB(70, 20, 20) end

		bindAction(btn, function()
			selectedLower[item.Name] = not selectedLower[item.Name]
			refreshGrudgeGUI()
		end)
	end
	lowerScroll.CanvasSize = UDim2.new(0, 0, 0, #grudgeKeys * 32)
end

bindAction(addBtn, function()
	for plr, sel in pairs(selectedUpper) do
		if sel and plr.Parent == Players then
			Grudges[plr.Name] = plr.DisplayName
		end
	end
	selectedUpper = {}
	saveGrudges()
	updateAllButtonStrokes()
	refreshGrudgeGUI()
end)

bindAction(removeBtn, function()
	for name, sel in pairs(selectedLower) do
		if sel then
			Grudges[name] = nil
		end
	end
	selectedLower = {}
	saveGrudges()
	updateAllButtonStrokes()
	refreshGrudgeGUI()
end)

