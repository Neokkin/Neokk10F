local function applyVoidStyle(guiObject, strokeColor)
	guiObject.BackgroundColor3 = THEME.BgDark
	guiObject.BorderSizePixel = 0
	guiObject.Active = true

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	if guiObject:IsA("TextButton") and guiObject.Size.X.Offset == guiObject.Size.Y.Offset then
		corner.CornerRadius = UDim.new(1, 0)
	end
	corner.Parent = guiObject

	local stroke = Instance.new("UIStroke")
	local defaultColor = strokeColor or THEME.AccentNeon
	stroke.Color = defaultColor
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = guiObject

	table.insert(allStrokes, { stroke = stroke, defaultColor = defaultColor, gui = guiObject })
	return stroke
end

