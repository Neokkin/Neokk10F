-- 5. PHANTOM MODE ENGINE (👻)
local phantomModeEnabled = false
local phantomFirstTriggered = false

local function updatePhantomMode()
	local char = LocalPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanTouch = not phantomModeEnabled
			end
		end
	end
end

local function togglePhantomMode()
	phantomModeEnabled = not phantomModeEnabled
	
	if phantomModeEnabled and not phantomFirstTriggered then
		phantomFirstTriggered = true
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name == "AntiCheatNPC2" or obj.Name == "AntiCheatNPC" then
				obj:Destroy()
			end
		end
	end

	updatePhantomMode()
	updateAllButtonStrokes()
end

bindAction(phantomButton, togglePhantomMode)

LocalPlayer.CharacterAdded:Connect(function(char)
	char.DescendantAdded:Connect(function(desc)
		if phantomModeEnabled and desc:IsA("BasePart") then
			desc.CanTouch = false
		end
	end)
	task.defer(updatePhantomMode)
end)

-- 6. DIAMOND MAGNET & SOUL SNATCH ENGINE (💎)
local diamondMagnetEnabled = false
local treasureFirstToggled = false

local function snatchSoul()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local nearestSoul = nil
	local shortestDist = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "Soul" and obj:IsA("BasePart") then
			local dist = (obj.Position - hrp.Position).Magnitude
			if dist < shortestDist then
				shortestDist = dist
				nearestSoul = obj
			end
		end
	end

	if nearestSoul then
		hrp.CFrame = nearestSoul.CFrame
	end
end

bindAction(soulButton, snatchSoul)

local function toggleDiamondMagnet()
	diamondMagnetEnabled = not diamondMagnetEnabled
	
	if diamondMagnetEnabled then
		if not treasureFirstToggled then
			treasureFirstToggled = true
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj.Name == "Diamond" or obj.Name == "DiamondDrop" then
					obj:Destroy()
				end
			end
		end
	end

	updateAllButtonStrokes()
end

bindAction(diamondButton, toggleDiamondMagnet)

task.spawn(function()
	while task.wait(0.1) do
		if diamondMagnetEnabled then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local targetCFrame = hrp.CFrame
				for _, obj in ipairs(Workspace:GetDescendants()) do
					if obj:IsA("MeshPart") and (obj.Name == "DiamondDrop" or obj.Name == "Diamond") then
						obj.CFrame = targetCFrame
					end
				end
			end
		end
	end
end)

-- 7. STROKE UPDATE SYSTEM
function updateAllButtonStrokes()
	for i = #allStrokes, 1, -1 do
		local item = allStrokes[i]
		if not item.stroke or not item.stroke.Parent then
			table.remove(allStrokes, i)
		else
			local targetColor = item.defaultColor
			
			if item.gui == grudgeButton then
				local hasGrudgeInServer = false
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and Grudges[p.Name] then
						hasGrudgeInServer = true
						break
					end
				end
				if hasGrudgeInServer then targetColor = THEME.RedAccent end
			elseif item.gui == phantomButton then
				targetColor = phantomModeEnabled and THEME.Selected or THEME.AccentNeon
			elseif item.gui == diamondButton then
				targetColor = diamondMagnetEnabled and THEME.Selected or THEME.AccentNeon
			end

			TweenService:Create(item.stroke, TweenInfo.new(0.3), { Color = targetColor }):Play()
		end
	end
end

Players.PlayerAdded:Connect(updateAllButtonStrokes)
Players.PlayerRemoving:Connect(updateAllButtonStrokes)

