-- Deletes ALL "Blind" descendants inside ReplicatedStorage (including deeply nested ones like StarShard.Blind)
local function purgeAllBlindInReplicatedStorage()
	for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
		if obj.Name == "Blind" then
			pcall(function() obj:Destroy() end)
		end
	end
end

purgeAllBlindInReplicatedStorage()

-- Catch any newly added "Blind" instances deep inside ReplicatedStorage trees
ReplicatedStorage.DescendantAdded:Connect(function(desc)
	if desc.Name == "Blind" then
		task.defer(function()
			pcall(function() desc:Destroy() end)
		end)
	end
end)

