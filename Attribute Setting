-- Double Click Actions
local function attachDoubleClick(button, callback)
    local lastClick = 0
    local conn = button.MouseButton1Click:Connect(function()
        local now = tick()
        if now - lastClick <= 0.35 then callback() lastClick = 0 else lastClick = now end
    end)
    table.insert(connections, conn)
end

