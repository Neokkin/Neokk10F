            LoadoutToggleAttrBtn.Position = UDim2.new(0.85, 0, 0, 6)
            LoadoutToggleAttrBtn.BackgroundColor3 = loadoutToggledAttributes[attrName] and Color3.fromRGB(0, 240, 255) or Color3.fromRGB(30, 18, 48)
            LoadoutToggleAttrBtn.Text = "{#}"
            LoadoutToggleAttrBtn.TextColor3 = loadoutToggledAttributes[attrName] and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
            LoadoutToggleAttrBtn.TextSize = 10
            LoadoutToggleAttrBtn.Font = Enum.Font.SourceSansBold
            LoadoutToggleAttrBtn.Parent = RowFrame
            applyNeonStroke(LoadoutToggleAttrBtn, Color3.fromRGB(0, 240, 255), 1)

            InputBox.FocusLost:Connect(function(enter)
                if enter then
                    local val = (valueType == "number") and (tonumber(InputBox.Text) or attrValue) or InputBox.Text
                    targetObj:SetAttribute(attrName, val)
                    if lockedAttributes[attrName] ~= nil then lockedAttributes[attrName] = val end
                end
            end)

            LockBtn.MouseButton1Click:Connect(function()
                if lockedAttributes[attrName] ~= nil then
                    lockedAttributes[attrName] = nil
                    LockBtn.BackgroundColor3 = Color3.fromRGB(30, 18, 48)
                else
