--          SMOOTH DRAGGING & RESIZING (BOUND TO SCREEN)          --
--================================================================--
local isDragging, isResizing = false, false
local dragStart, resizeStart = Vector2.new(), Vector2.new()
local startPos, startSize = Vector2.new(), Vector2.new()

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPos = Vector2.new(MainFrame.AbsolutePosition.X, MainFrame.AbsolutePosition.Y)
    end
end)

ResizeGrip.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isResizing = true
        resizeStart = Vector2.new(input.Position.X, input.Position.Y)
        startSize = Vector2.new(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
        isResizing = false
    end
end)

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
        
        if isDragging then
            local currentInput = Vector2.new(input.Position.X, input.Position.Y)
            local delta = currentInput - dragStart
            
            local maxFrameX = math.max(0, viewport.X - MainFrame.AbsoluteSize.X)
            local maxFrameY = math.max(0, viewport.Y - MainFrame.AbsoluteSize.Y)
            
            local newX = math.clamp(startPos.X + delta.X, 0, maxFrameX)
            local newY = math.clamp(startPos.Y + delta.Y, 0, maxFrameY)
            
            MainFrame.Position = UDim2.new(0, newX, 0, newY)
        elseif isResizing then
            local currentInput = Vector2.new(input.Position.X, input.Position.Y)
            local delta = currentInput - resizeStart
            
            local maxWidth = math.max(260, viewport.X - MainFrame.AbsolutePosition.X)
            local maxHeight = math.max(200, viewport.Y - MainFrame.AbsolutePosition.Y)
            
            local newWidth = math.clamp(startSize.X + delta.X, 260, maxWidth)
            local newHeight = math.clamp(startSize.Y + delta.Y, 200, maxHeight)
            
            MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
        end
    end
end))

--================================================================--
--              FILE / PARENT HIERARCHY ATTRIBUTE RENDERING       --
--================================================================--
local function renderAttributes()
    for _, child in ipairs(MainScroll:GetChildren()) do 
        if child:IsA("Frame") then child:Destroy() end 
    end

    clearAttrConnections()

    local targetObj = getTargetObject()
    if not targetObj then return end

    local rawObjects = { targetObj }
    if isExpandSearch then
        for _, desc in ipairs(targetObj:GetDescendants()) do
            table.insert(rawObjects, desc)
        end
    end

    local objectsToScan = {}
    for _, obj in ipairs(rawObjects) do
        if not isExcludedPlayerChild(obj) then
            table.insert(objectsToScan, obj)
        end
    end

    -- Group attributes and ValueObjects by File / Parent Instance
    local groups = {}
    local processedValueObjs = {}

    for _, obj in ipairs(objectsToScan) do
        local itemEntries = {}

        -- 1. Scan Standard Attributes
        local attrs = obj:GetAttributes()
        for k, v in pairs(attrs) do
            table.insert(itemEntries, {
                name = k,
                value = v,
                vType = type(v),
                isValueObj = false
            })
        end

        -- 2. Scan Child ValueObjects (NumberValue, IntValue, StringValue, BoolValue, etc.)
        for _, child in ipairs(obj:GetChildren()) do
            if isSupportedValueObject(child) and not processedValueObjs[child] then
                processedValueObjs[child] = true
                local vType = getValueObjectType(child)
                if vType then
                    table.insert(itemEntries, {
                        name = child.Name,
                        value = child.Value,
                        vType = vType,
                        isValueObj = true,
                        valInst = child
                    })
                end
            end
        end

        if #itemEntries > 0 then
            table.sort(itemEntries, function(a, b) return a.name:lower() < b.name:lower() end)
            table.insert(groups, {
                object = obj,
                path = getObjectPath(targetObj, obj),
                entries = itemEntries
            })

            -- Attach listeners for real-time updates
            local conn1 = obj.AttributeChanged:Connect(function()
                renderAttributes()
            end)
            table.insert(currentAttrConnections, conn1)

            local conn2 = obj.ChildAdded:Connect(function(child)
                if isSupportedValueObject(child) then renderAttributes() end
            end)
            table.insert(currentAttrConnections, conn2)

            local conn3 = obj.ChildRemoved:Connect(function(child)
                if isSupportedValueObject(child) then renderAttributes() end
            end)
            table.insert(currentAttrConnections, conn3)
        end
    end

    table.sort(groups, function(a, b) return a.path:lower() < b.path:lower() end)

    -- Render File Parents & Attributes / ValueObjects
    for _, group in ipairs(groups) do
        local FileHeader = Instance.new("Frame")
        FileHeader.Size = UDim2.new(1, -6, 0, 22)
        FileHeader.BackgroundColor3 = Color3.fromRGB(32, 18, 50)
        FileHeader.Parent = MainScroll
        applyNeonStroke(FileHeader, Color3.fromRGB(255, 0, 128), 1)

        local FileLabel = Instance.new("TextLabel")
        FileLabel.Size = UDim2.new(1, -8, 1, 0)
        FileLabel.Position = UDim2.new(0, 4, 0, 0)
        FileLabel.BackgroundTransparency = 1
        FileLabel.Text = "📁 " .. group.path
        FileLabel.TextColor3 = Color3.fromRGB(0, 240, 255)
        FileLabel.TextSize = 10
        FileLabel.Font = Enum.Font.FredokaOne
        FileLabel.TextXAlignment = Enum.TextXAlignment.Left
        FileLabel.Parent = FileHeader

        for _, entry in ipairs(group.entries) do
            local attrName = entry.name
            local attrValue = entry.value
            local valueType = entry.vType
            local isValObj = entry.isValueObj
            local valInst = entry.valInst
            
            local fullAttrKey = group.path .. (isValObj and ".[Val]." or ".") .. attrName

            local RowFrame = Instance.new("Frame")
            RowFrame.Size = UDim2.new(1, -6, 0, 28)
            RowFrame.BackgroundColor3 = Color3.fromRGB(22, 14, 36)
            RowFrame.Parent = MainScroll
            applyNeonStroke(RowFrame, Color3.fromRGB(45, 25, 70), 1)

            local NameLabel = Instance.new("TextLabel")
            NameLabel.Size = UDim2.new(0.34, -4, 1, 0)
            NameLabel.Position = UDim2.new(0, 6, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = (isValObj and "🔹 " or "") .. attrName
            NameLabel.TextColor3 = isValObj and Color3.fromRGB(180, 220, 255) or Color3.fromRGB(230, 230, 255)
            NameLabel.TextSize = 10
            NameLabel.Font = Enum.Font.SourceSansBold
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.Parent = RowFrame

            local LockBtn = Instance.new("TextButton")
            LockBtn.Size = UDim2.new(0.11, 0, 0, 18)
            LockBtn.Position = UDim2.new(0.73, 0, 0, 5)
            LockBtn.BackgroundColor3 = lockedAttributes[fullAttrKey] ~= nil and Color3.fromRGB(255, 0, 128) or Color3.fromRGB(30, 18, 48)
            LockBtn.Text = "§"
            LockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            LockBtn.TextSize = 11
            LockBtn.Font = Enum.Font.SourceSansBold
            LockBtn.Parent = RowFrame
            applyNeonStroke(LockBtn, Color3.fromRGB(255, 0, 128), 1)

            local LoadoutToggleAttrBtn = Instance.new("TextButton")
            LoadoutToggleAttrBtn.Size = UDim2.new(0.13, 0, 0, 18)
            LoadoutToggleAttrBtn.Position = UDim2.new(0.85, 0, 0, 5)
            LoadoutToggleAttrBtn.BackgroundColor3 = loadoutToggledAttributes[fullAttrKey] and Color3.fromRGB(0, 240, 255) or Color3.fromRGB(30, 18, 48)
            LoadoutToggleAttrBtn.Text = "{#}"
            LoadoutToggleAttrBtn.TextColor3 = loadoutToggledAttributes[fullAttrKey] and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
            LoadoutToggleAttrBtn.TextSize = 10
            LoadoutToggleAttrBtn.Font = Enum.Font.SourceSansBold
            LoadoutToggleAttrBtn.Parent = RowFrame
            applyNeonStroke(LoadoutToggleAttrBtn, Color3.fromRGB(0, 240, 255), 1)

            if isValObj and valInst then
                local connVal = valInst:GetPropertyChangedSignal("Value"):Connect(function()
                    renderAttributes()
                end)
                table.insert(currentAttrConnections, connVal)
            end

            if valueType == "string" or valueType == "number" then
                local InputBox = Instance.new("TextBox")
                InputBox.Size = UDim2.new(0.35, 0, 0, 18)
                InputBox.Position = UDim2.new(0.36, 0, 0, 5)
                InputBox.BackgroundColor3 = Color3.fromRGB(10, 6, 18)
                InputBox.Text = tostring(attrValue)
                InputBox.TextColor3 = Color3.fromRGB(0, 240, 255)
                InputBox.TextSize = 10
                InputBox.Font = Enum.Font.Code
                InputBox.ClearTextOnFocus = false
                InputBox.Parent = RowFrame
                applyNeonStroke(InputBox, Color3.fromRGB(0, 240, 255), 1)

                InputBox.FocusLost:Connect(function(enter)
                    if enter then
                        local currentVal = isValObj and valInst.Value or group.object:GetAttribute(attrName)
                        local val = (valueType == "number") and (tonumber(InputBox.Text) or currentVal) or InputBox.Text
                        if isValObj then
                            pcall(function() valInst.Value = val end)
                        else
                            group.object:SetAttribute(attrName, val)
                        end
                        if lockedAttributes[fullAttrKey] ~= nil then
                            lockedAttributes[fullAttrKey].value = val
                        end
                    end
                end)
            elseif valueType == "boolean" then
                local CheckBox = Instance.new("TextButton")
                CheckBox.Size = UDim2.new(0.35, 0, 0, 18)
                CheckBox.Position = UDim2.new(0.36, 0, 0, 5)
                CheckBox.BackgroundColor3 = attrValue and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(60, 20, 30)
                CheckBox.Text = attrValue and "[ TRUE ]" or "[ FALSE ]"
                CheckBox.TextColor3 = Color3.fromRGB(255, 255, 255)
                CheckBox.TextSize = 9
                CheckBox.Font = Enum.Font.Code
                CheckBox.Parent = RowFrame
                applyNeonStroke(CheckBox, attrValue and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 50, 80), 1)

                CheckBox.MouseButton1Click:Connect(function()
                    local currentVal = isValObj and valInst.Value or group.object:GetAttribute(attrName)
                    local newVal = not currentVal
                    if isValObj then
                        pcall(function() valInst.Value = newVal end)
                    else
                        group.object:SetAttribute(attrName, newVal)
                    end
                    if lockedAttributes[fullAttrKey] ~= nil then
                        lockedAttributes[fullAttrKey].value = newVal
                    end
                end)
            end

            LockBtn.MouseButton1Click:Connect(function()
                if lockedAttributes[fullAttrKey] ~= nil then
                    lockedAttributes[fullAttrKey] = nil
                    LockBtn.BackgroundColor3 = Color3.fromRGB(30, 18, 48)
                else
                    lockedAttributes[fullAttrKey] = {
                        object = isValObj and valInst or group.object,
                        isValueObj = isValObj,
                        attrName = attrName,
                        value = isValObj and valInst.Value or group.object:GetAttribute(attrName)
                    }
                    LockBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 128)
                end
            end)

            LoadoutToggleAttrBtn.MouseButton1Click:Connect(function()
                loadoutToggledAttributes[fullAttrKey] = not loadoutToggledAttributes[fullAttrKey]
                LoadoutToggleAttrBtn.BackgroundColor3 = loadoutToggledAttributes[fullAttrKey] and Color3.fromRGB(0, 240, 255) or Color3.fromRGB(30, 18, 48)
                LoadoutToggleAttrBtn.TextColor3 = loadoutToggledAttributes[fullAttrKey] and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
            end)
        end
    end

    MainScroll.CanvasSize = UDim2.new(0, 0, 0, MainLayout.AbsoluteContentSize.Y + 10)
end

getgenv().VaporwaveRefreshAttributes = renderAttributes

-- Continuous Lock Loop
table.insert(connections, RunService.Heartbeat:Connect(function()
    for fullKey, lockData in pairs(lockedAttributes) do
        if lockData and lockData.object and lockData.object.Parent then
            if lockData.isValueObj then
                if lockData.object.Value ~= lockData.value then
                    pcall(function() lockData.object.Value = lockData.value end)
                end
            else
                if lockData.object:GetAttribute(lockData.attrName) ~= lockData.value then
                    pcall(function() lockData.object:SetAttribute(lockData.attrName, lockData.value) end)
                end
            end
        end
    end
end))

