local function setupInventoryListeners()
    local char = LocalPlayer.Character
    if char then
        table.insert(connections, char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") and targetType == "Tools" then renderAttributes() end
        end))
        table.insert(connections, char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") and targetType == "Tools" then renderAttributes() end
        end))
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        table.insert(connections, backpack.ChildAdded:Connect(function(child)
            if child:IsA("Tool") and targetType == "Tools" then renderAttributes() end
        end))
        table.insert(connections, backpack.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") and targetType == "Tools" then renderAttributes() end
        end))
    end
end

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    setupInventoryListeners()
    renderAttributes()
end))

setupInventoryListeners()
renderAttributes()
renderLoadoutList()

-- Execute Auto Load if configured
if autoLoadName and savedLoadouts[autoLoadName] then
    task.spawn(function()
        task.wait(0.5)
        applyLoadout(autoLoadName)
    end)
end
