SaveBtn.MouseButton1Click:Connect(function()
    resetConfirmations()
    local name = LoadoutNameInput.Text:match("^%s*(.-)%s*$")
    if name == "" then return end

    local targetObj = getTargetObject()
    if not targetObj then return end

    local hasToggledAttributes = false
    for _, isToggled in pairs(loadoutToggledAttributes) do
        if isToggled then hasToggledAttributes = true; break end
    end

    local rawObjects = { targetObj }
    if isExpandSearch then
        for _, desc in ipairs(targetObj:GetDescendants()) do
            table.insert(rawObjects, desc)
        end
    end

    local objectsToScan = {}
    for _, obj in ipairs(rawObjects) do
        if not isExcludedPlayerChild(obj) then
            table.insert(objectsToScan, obj)
        end
    end

    local attrSnapshot = {}
    local lockSnapshot = {}
    local processedValueObjs = {}

    for _, obj in ipairs(objectsToScan) do
        local path = getObjectPath(targetObj, obj)
        
        -- Regular attributes
        for k, v in pairs(obj:GetAttributes()) do
            local fullKey = path .. "." .. k
            if not hasToggledAttributes or loadoutToggledAttributes[fullKey] then
                attrSnapshot[fullKey] = {
                    path = path,
                    attrName = k,
                    value = v,
                    isValueObj = false
                }
                if lockedAttributes[fullKey] ~= nil then
                    lockSnapshot[fullKey] = lockedAttributes[fullKey].value
                end
            end
        end

        -- ValueObjects (NumberValue, IntValue, StringValue, BoolValue)
        for _, child in ipairs(obj:GetChildren()) do
            if isSupportedValueObject(child) and not processedValueObjs[child] then
                processedValueObjs[child] = true
                local k = child.Name
                local v = child.Value
                local valPath = getObjectPath(targetObj, child)
                local fullKey = path .. ".[Val]." .. k
                if not hasToggledAttributes or loadoutToggledAttributes[fullKey] then
                    attrSnapshot[fullKey] = {
                        path = path,
                        valPath = valPath,
                        attrName = k,
                        value = v,
                        isValueObj = true
                    }
                    if lockedAttributes[fullKey] ~= nil then
                        lockSnapshot[fullKey] = lockedAttributes[fullKey].value
                    end
                end
            end
        end
    end

    savedLoadouts[name] = {
        attributes = attrSnapshot,
        locks = lockSnapshot,
        shield = isShieldOn,
        mode = currentMode
    }

    selectedLoadoutName = name
    saveToFile()
    renderLoadoutList()
end)

local function applyLoadout(name)
    local data = savedLoadouts[name]
    if not data then return end

    local targetObj = getTargetObject()
    if not targetObj then return end

    table.clear(lockedAttributes)

    for fullKey, item in pairs(data.attributes) do
        if item.isValueObj then
            local valObj = nil
            if item.valPath then
                valObj = findObjectByPath(targetObj, item.valPath)
            else
                local parentObj = findObjectByPath(targetObj, item.path)
                if parentObj then
                    valObj = parentObj:FindFirstChild(item.attrName)
                end
            end

            if valObj and valObj:IsA("ValueBase") then
                pcall(function() valObj.Value = item.value end)
                if data.locks and data.locks[fullKey] ~= nil then
                    lockedAttributes[fullKey] = {
                        object = valObj,
                        isValueObj = true,
                        attrName = item.attrName,
                        value = data.locks[fullKey]
                    }
                end
            end
        else
            local obj = findObjectByPath(targetObj, item.path)
            if obj then
                pcall(function() obj:SetAttribute(item.attrName, item.value) end)
                if data.locks and data.locks[fullKey] ~= nil then
                    lockedAttributes[fullKey] = {
                        object = obj,
                        isValueObj = false,
                        attrName = item.attrName,
                        value = data.locks[fullKey]
                    }
                end
            end
        end
    end

    isShieldOn = data.shield
    currentMode = data.mode

    if getgenv().VaporwaveRefreshAttributes then
        getgenv().VaporwaveRefreshAttributes()
    end
end

