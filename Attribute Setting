                if lockedAttributes[attrName] ~= nil then lockedAttributes[attrName] = newVal end
            end)

            LockBtn.MouseButton1Click:Connect(function()
                if lockedAttributes[attrName] ~= nil then
                    lockedAttributes[attrName] = nil
                    LockBtn.BackgroundColor3 = Color3.fromRGB(30, 18, 48)
                else
                    lockedAttributes[attrName] = LocalPlayer:GetAttribute(attrName)
                    LockBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 128)
