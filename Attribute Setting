            LockBtn.TextSize = 11
            LockBtn.Font = Enum.Font.SourceSansBold
            LockBtn.Parent = RowFrame
            applyNeonStroke(LockBtn, Color3.fromRGB(255, 0, 128), 1)

            local LoadoutToggleAttrBtn = Instance.new("TextButton")
            LoadoutToggleAttrBtn.Size = UDim2.new(0.13, 0, 0, 20)
            LoadoutToggleAttrBtn.Position = UDim2.new(0.85, 0, 0, 6)
