-- Save Handler (saves only {#} toggled attributes if any are toggled)
SaveBtn.MouseButton1Click:Connect(function()
    resetConfirmations()
    local name = LoadoutNameInput.Text:match("^%s*(.-)%s*$")
    if name == "" then return end

    local hasToggledAttributes = false
    for _, isToggled in pairs(loadoutToggledAttributes) do
        if isToggled then
            hasToggledAttributes = true
            break
        end
    end

    local attrSnapshot = {}
    local lockSnapshot = {}

    for k, v in pairs(LocalPlayer:GetAttributes()) do
        if not hasToggledAttributes or loadoutToggledAttributes[k] then
            attrSnapshot[k] = v
            if lockedAttributes[k] ~= nil then
                lockSnapshot[k] = lockedAttributes[k]
            end
        end
    end

    savedLoadouts[name] = {
        attributes = attrSnapshot,
        locks = lockSnapshot,
        shield = isShieldOn,
        mode = currentMode
    }

    selectedLoadoutName = name
    saveToFile()
    renderLoadoutList()
end)

-- Load Handler
local function applyLoadout(name)
    local data = savedLoadouts[name]
    if not data then return end

    table.clear(lockedAttributes)

    for k, v in pairs(data.attributes) do
        LocalPlayer:SetAttribute(k, v)
    end

    for k, v in pairs(data.locks) do
        lockedAttributes[k] = v
    end

    isShieldOn = data.shield
    currentMode = data.mode

    if getgenv().VaporwaveRefreshAttributes then
        getgenv().VaporwaveRefreshAttributes()
    end
end

LoadBtn.MouseButton1Click:Connect(function()
    resetConfirmations()
    if selectedLoadoutName then
        applyLoadout(selectedLoadoutName)
    end
end)

-- Edit Handler with Confirmation Highlight
EditBtn.MouseButton1Click:Connect(function()
    if not selectedLoadoutName or not savedLoadouts[selectedLoadoutName] then return end

    if pendingEditName ~= selectedLoadoutName then
        resetConfirmations()
        pendingEditName = selectedLoadoutName
        EditBtn.Text = "[SURE?]"
        EditBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
    else
        applyLoadout(selectedLoadoutName)
        LoadoutNameInput.Text = selectedLoadoutName
        resetConfirmations()
        renderLoadoutList()
    end
end)

-- Delete Handler with Confirmation Highlight
DeleteBtn.MouseButton1Click:Connect(function()
    if not selectedLoadoutName or not savedLoadouts[selectedLoadoutName] then return end

    if pendingDeleteName ~= selectedLoadoutName then
        resetConfirmations()
        pendingDeleteName = selectedLoadoutName
        DeleteBtn.Text = "[SURE?]"
        DeleteBtn.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
    else
        savedLoadouts[selectedLoadoutName] = nil
        if LoadoutNameInput.Text == selectedLoadoutName then
            LoadoutNameInput.Text = ""
        end
        selectedLoadoutName = nil
        saveToFile()
        resetConfirmations()
        renderLoadoutList()
    end
end)

