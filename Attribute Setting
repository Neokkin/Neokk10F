local function clearAttrConnections()
    for _, conn in ipairs(currentAttrConnections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    table.clear(currentAttrConnections)
end

local function fullCleanup()
    for _, conn in ipairs(connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    table.clear(connections)
    table.clear(lockedAttributes)
    clearAttrConnections()
    
    local existingGui = targetParent:FindFirstChild(GUI_NAME)
    if existingGui then existingGui:Destroy() end
    getgenv().VaporwaveAttrGuiCleanup = nil
end

getgenv().VaporwaveAttrGuiCleanup = fullCleanup

