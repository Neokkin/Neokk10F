-- File I/O for JSON Persistence
local function saveToFile()
    if writefile then
        pcall(function()
            writefile(JSON_FILE_NAME, HttpService:JSONEncode(savedLoadouts))
        end)
    end
end

local function loadFromFile()
    if isfile and readfile and isfile(JSON_FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(JSON_FILE_NAME))
        end)
        if success and type(result) == "table" then
            savedLoadouts = result
        end
    end
end

