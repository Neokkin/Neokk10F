-- ValueBase Helpers (NumberValue, IntValue, StringValue, BoolValue, etc.)
local function isSupportedValueObject(inst)
    if not inst or not inst:IsA("ValueBase") then return false end
    return inst:IsA("NumberValue") or inst:IsA("IntValue")
        or inst:IsA("StringValue") or inst:IsA("BoolValue")
        or inst:IsA("DoubleConstrainedValue") or inst:IsA("IntConstrainedValue")
end

local function getValueObjectType(inst)
    if inst:IsA("NumberValue") or inst:IsA("IntValue") or inst:IsA("DoubleConstrainedValue") or inst:IsA("IntConstrainedValue") then
        return "number"
    elseif inst:IsA("StringValue") then
        return "string"
    elseif inst:IsA("BoolValue") then
        return "boolean"
    end
    return nil
end

-- Exclude Roblox core stuff & Backpack under "Player" target
local function isExcludedPlayerChild(obj)
    if targetType ~= "Player" then return false end
    if obj == LocalPlayer then return false end

    local current = obj
    while current and current ~= LocalPlayer do
        local name = current.Name:lower()
        local className = current.ClassName
        
        if current.Name == "PlayerGui" or current.Name == "Backpack" 
           or current.Name == "PlayerScripts" or current.Name == "StarterGear"
           or className == "PlayerGui" or className == "Backpack" 
           or className == "PlayerScripts" or className == "StarterGear"
           or name:find("chat") or name:find("core") then
            return true
        end
        current = current.Parent
    end
    return false
end

-- File I/O for JSON Persistence
local function saveToFile()
    if writefile then
        pcall(function()
            local dataToSave = {
                loadouts = savedLoadouts,
                autoLoad = autoLoadName
            }
            writefile(JSON_FILE_NAME, HttpService:JSONEncode(dataToSave))
        end)
    end
end

local function loadFromFile()
    if isfile and readfile and isfile(JSON_FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(JSON_FILE_NAME))
        end)
        if success and type(result) == "table" then
            if result.loadouts then
                savedLoadouts = result.loadouts or {}
                autoLoadName = result.autoLoad
            else
                savedLoadouts = result
            end
        end
    end
end

loadFromFile()

-- Target Object & Hierarchy Resolution
local function getObjectPath(root, obj)
    if not root or not obj then return "" end
    if obj == root then return root.Name end
    local path = obj.Name
    local current = obj.Parent
    while current and current ~= root do
        path = current.Name .. "." .. path
        current = current.Parent
    end
    if current == root then
        path = root.Name .. "." .. path
    end
    return path
end

local function findObjectByPath(root, path)
    if not root or not path then return nil end
    if path == root.Name then return root end
    
    local prefix = root.Name .. "."
    if path:sub(1, #prefix) == prefix then
        local relative = path:sub(#prefix + 1)
        local current = root
        for segment in string.gmatch(relative, "[^%.]+") do
            current = current:FindFirstChild(segment)
            if not current then return nil end
        end
        return current
    end
    return nil
end

local function getAllTools()
    local toolNames = {}
    local seen = {}

    local char = LocalPlayer.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and not seen[item.Name] then
                seen[item.Name] = true
                table.insert(toolNames, item.Name)
            end
        end
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and not seen[item.Name] then
                seen[item.Name] = true
                table.insert(toolNames, item.Name)
            end
        end
    end

    table.sort(toolNames, function(a, b) return a:lower() < b:lower() end)
    return toolNames
end

local function getTargetTool()
    local toolNames = getAllTools()
    if not selectedToolName or not table.find(toolNames, selectedToolName) then
        selectedToolName = toolNames[1]
    end
    if not selectedToolName then return nil end

    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChild(selectedToolName)
        if tool and tool:IsA("Tool") then return tool end
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild(selectedToolName)
        if tool and tool:IsA("Tool") then return tool end
    end

    return nil
end

local function getTargetObject()
    if targetType == "Player" then
        return LocalPlayer
    elseif targetType == "Character" then
        return LocalPlayer.Character
    elseif targetType == "Tools" then
        return getTargetTool()
    end
    return nil
end

