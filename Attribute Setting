        if child:IsA("TextButton") then child:Destroy() end
    end

    local toolNames = getAllTools()
    if #toolNames == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, 0, 0, 20)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Text = "No tools found"
        emptyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        emptyLabel.TextSize = 10
        emptyLabel.Font = Enum.Font.SourceSans
        emptyLabel.Parent = ToolsDropdownScroll
    else
        for _, tName in ipairs(toolNames) do
            local isSelected = (selectedToolName == tName)
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, -4, 0, 20)
            itemBtn.BackgroundColor3 = isSelected and Color3.fromRGB(50, 25, 70) or Color3.fromRGB(26, 16, 40)
            itemBtn.Text = " " .. tName
            itemBtn.TextColor3 = isSelected and Color3.fromRGB(0, 240, 255) or Color3.fromRGB(200, 200, 220)
            itemBtn.TextSize = 10
            itemBtn.Font = Enum.Font.SourceSansBold
            itemBtn.TextXAlignment = Enum.TextXAlignment.Left
            itemBtn.Parent = ToolsDropdownScroll
            applyNeonStroke(itemBtn, isSelected and Color3.fromRGB(0, 240, 255) or Color3.fromRGB(45, 25, 65), 1)

            itemBtn.MouseButton1Click:Connect(function()
                selectedToolName = tName
                targetType = "Tools"
                TargetPlayerBtn.BackgroundColor3 = Color3.fromRGB(20, 12, 35); TargetPlayerBtn.TextColor3 = Color3.fromRGB(150, 150, 180)
                TargetCharBtn.BackgroundColor3 = Color3.fromRGB(20, 12, 35); TargetCharBtn.TextColor3 = Color3.fromRGB(150, 150, 180)
                TargetToolsBtn.BackgroundColor3 = Color3.fromRGB(35, 20, 55); TargetToolsBtn.TextColor3 = Color3.fromRGB(0, 240, 255)
                applyNeonStroke(TargetPlayerBtn, Color3.fromRGB(80, 50, 100), 1)
                applyNeonStroke(TargetCharBtn, Color3.fromRGB(80, 50, 100), 1)
                applyNeonStroke(TargetToolsBtn, Color3.fromRGB(0, 240, 255), 1)
                
                ToolsDropdownFrame.Visible = false
                renderToolsDropdown()
                if getgenv().VaporwaveRefreshAttributes then getgenv().VaporwaveRefreshAttributes() end
            end)
        end
    end

    ToolsDropdownScroll.CanvasSize = UDim2.new(0, 0, 0, ToolsDropdownLayout.AbsoluteContentSize.Y + 5)
end

