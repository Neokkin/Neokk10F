-- Dragging & Resizing Logic
local isDragging, isResizing = false, false
local dragStart, resizeStart = Vector3.new(), Vector3.new()
local startPos, startSize = UDim2.new(), UDim2.new()

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true; dragStart = input.Position; startPos = MainFrame.Position
    end
end)

ResizeGrip.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isResizing = true; resizeStart = input.Position; startSize = MainFrame.Size
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false; isResizing = false
    end
end)

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
        if isDragging then
            local delta = input.Position - dragStart
            local newX = math.clamp(startPos.X.Offset + delta.X, 0, viewport.X - MainFrame.AbsoluteSize.X)
            local newY = math.clamp(startPos.Y.Offset + delta.Y, 0, viewport.Y - MainFrame.AbsoluteSize.Y)
            MainFrame.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
        elseif isResizing then
            local delta = input.Position - resizeStart
            local newWidth = math.clamp(startSize.X.Offset + delta.X, 260, viewport.X - MainFrame.AbsolutePosition.X)
            local newHeight = math.clamp(startSize.Y.Offset + delta.Y, 200, viewport.Y - MainFrame.AbsolutePosition.Y)
            MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
        end
    end
end))

-- Attribute Rendering Logic
local function renderAttributes()
    for _, child in ipairs(Tab1Scroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    for _, child in ipairs(Tab2Scroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end

    local targetObj = getTargetObject()

    if currentAttrConnection and currentAttrConnection.Connected then
        currentAttrConnection:Disconnect()
        currentAttrConnection = nil
    end

    if not targetObj then return end

    currentAttrConnection = targetObj.AttributeChanged:Connect(function()
        renderAttributes()
    end)

    local attributes = targetObj:GetAttributes()
    local attrKeys = {}
    for key in pairs(attributes) do table.insert(attrKeys, key) end
    table.sort(attrKeys, function(a, b) return a:lower() < b:lower() end)

    for _, attrName in ipairs(attrKeys) do
        local attrValue = attributes[attrName]
        local valueType = type(attrValue)

        if valueType == "string" or valueType == "number" then
            local RowFrame = Instance.new("Frame")
            RowFrame.Size = UDim2.new(1, -6, 0, 32)
            RowFrame.BackgroundColor3 = Color3.fromRGB(22, 14, 36)
            RowFrame.Parent = Tab1Scroll
            applyNeonStroke(RowFrame, Color3.fromRGB(45, 25, 70), 1)

            local NameLabel = Instance.new("TextLabel")
            NameLabel.Size = UDim2.new(0.32, -2, 1, 0)
            NameLabel.Position = UDim2.new(0, 4, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = attrName
            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameLabel.TextSize = 10
            NameLabel.Font = Enum.Font.SourceSansBold
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.Parent = RowFrame

            local InputBox = Instance.new("TextBox")
            InputBox.Size = UDim2.new(0.38, 0, 0, 18)
            InputBox.Position = UDim2.new(0.34, 0, 0, 7)
            InputBox.BackgroundColor3 = Color3.fromRGB(10, 6, 18)
            InputBox.Text = tostring(attrValue)
            InputBox.TextColor3 = Color3.fromRGB(0, 240, 255)
            InputBox.TextSize = 10
            InputBox.Font = Enum.Font.Code
            InputBox.ClearTextOnFocus = false
            InputBox.Parent = RowFrame
