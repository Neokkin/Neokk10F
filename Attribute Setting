local function renderLoadoutList()
    for _, item in ipairs(LoadoutScroll:GetChildren()) do
        if item:IsA("TextButton") then item:Destroy() end
    end

    for name, _ in pairs(savedLoadouts) do
        local isAutoLoaded = (autoLoadName == name)
        local itemBtn = Instance.new("TextButton")
        itemBtn.Size = UDim2.new(1, -4, 0, 22)
        
        if isAutoLoaded then
            itemBtn.BackgroundColor3 = Color3.fromRGB(15, 45, 25)
            itemBtn.TextColor3 = Color3.fromRGB(0, 255, 120)
            itemBtn.Text = "  " .. name .. " [AUTO]"
        else
            itemBtn.BackgroundColor3 = (selectedLoadoutName == name) and Color3.fromRGB(50, 25, 70) or Color3.fromRGB(26, 16, 40)
            itemBtn.TextColor3 = (selectedLoadoutName == name) and Color3.fromRGB(255, 0, 128) or Color3.fromRGB(200, 200, 220)
            itemBtn.Text = "  " .. name
        end
        
        itemBtn.TextSize = 10
        itemBtn.Font = Enum.Font.SourceSansBold
        itemBtn.TextXAlignment = Enum.TextXAlignment.Left
        itemBtn.Parent = LoadoutScroll
        
        local strokeColor = isAutoLoaded and Color3.fromRGB(0, 255, 120) or ((selectedLoadoutName == name) and Color3.fromRGB(255, 0, 128) or Color3.fromRGB(45, 25, 65))
        applyNeonStroke(itemBtn, strokeColor, 1)

        itemBtn.MouseButton1Click:Connect(function()
            if selectedLoadoutName ~= name then resetConfirmations() end
            selectedLoadoutName = name
            renderLoadoutList()
        end)
    end

    LoadoutScroll.CanvasSize = UDim2.new(0, 0, 0, LoadoutListLayout.AbsoluteContentSize.Y + 5)
end

